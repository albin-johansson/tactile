{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0
  },
  "configurePresets": [
    {
      "name": "_default",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_SKIP_INSTALL_ALL_DEPENDENCY": "ON",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/tools/cmake/vcpkg/triplets",
        "TACTILE_ENABLE_TESTS": "ON",
        "TACTILE_ENABLE_EDITOR": "ON",
        "TACTILE_ENABLE_ZLIB": "ON",
        "TACTILE_ENABLE_ZSTD": "ON",
        "TACTILE_ENABLE_YAML": "ON",
        "TACTILE_ENABLE_TMJ": "ON",
        "TACTILE_ENABLE_TMX": "ON",
        "TACTILE_ENABLE_TSCN": "ON",
        "TACTILE_ENABLE_LTO": "OFF"
      }
    },
    {
      "name": "_default-debug",
      "hidden": true,
      "inherits": [
        "_default"
      ],
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "_default-release",
      "hidden": true,
      "inherits": [
        "_default"
      ],
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TACTILE_ENABLE_LTO": "ON"
      }
    },
    {
      "name": "_use-mold-linker",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=mold",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=mold"
      }
    },
    {
      "name": "_arm64-osx-homebrew-llvm",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/tools/cmake/vcpkg/toolchains/arm64-osx-homebrew-llvm.cmake",
        "VCPKG_TARGET_TRIPLET": "tactile-arm64-osx-homebrew-llvm"
      }
    },
    {
      "name": "_x64-linux",
      "hidden": true,
      "inherits": [
        "_use-mold-linker"
      ],
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "tactile-x64-linux"
      }
    },
    {
      "name": "_x64-windows",
      "hidden": true,
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "tactile-x64-windows"
      }
    },
    {
      "name": "arm64-osx-homebrew-llvm-debug",
      "inherits": [
        "_arm64-osx-homebrew-llvm",
        "_default-debug"
      ]
    },
    {
      "name": "arm64-osx-homebrew-llvm-release",
      "inherits": [
        "_arm64-osx-homebrew-llvm",
        "_default-release"
      ]
    },
    {
      "name": "x64-linux-debug",
      "inherits": [
        "_x64-linux",
        "_default-debug"
      ]
    },
    {
      "name": "x64-linux-release",
      "inherits": [
        "_x64-linux",
        "_default-release"
      ]
    },
    {
      "name": "x64-windows-debug",
      "inherits": [
        "_x64-windows",
        "_default-debug"
      ]
    },
    {
      "name": "x64-windows-release",
      "inherits": [
        "_x64-windows",
        "_default-release"
      ]
    }
  ]
}
