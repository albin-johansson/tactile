{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "tactile",
  "license": "GPL-3.0",
  "version-semver": "0.5.0",
  "maintainers": [
    "albin-johansson"
  ],
  "builtin-baseline": "b505fa789fd96eb5496a2e42c651c169e8460d27",
  "dependencies": [
    "boost-container",
    "boost-stacktrace",
    "entt",
    "cppcodec",
    "fast-float",
    "fmt",
    "magic-enum",
    "nlohmann-json",
    "pugixml",
    "sdl2",
    "stb",
    "yaml-cpp",
    "zlib",
    "zstd"
  ],
  "features": {
    "tests": {
      "description": "Add testing support",
      "dependencies": [
        "gtest"
      ]
    },
    "editor": {
      "description": "Build the Tactile editor",
      "dependencies": [
        "argparse",
        {
          "name": "imgui",
          "features": [
            "docking-experimental",
            "sdl2-binding"
          ]
        },
        "tinyfiledialogs"
      ]
    },
    "opengl": {
      "description": "Add OpenGL support",
      "dependencies": [
        {
          "name": "glad",
          "features": [
            "extensions"
          ]
        },
        {
          "name": "imgui",
          "features": [
            "opengl3-binding"
          ]
        }
      ]
    },
    "vulkan": {
      "description": "Add Vulkan support",
      "dependencies": [
        "vulkan",
        "vulkan-memory-allocator",
        {
          "name": "sdl2",
          "features": [
            "vulkan"
          ]
        },
        {
          "name": "imgui",
          "features": [
            "vulkan-binding"
          ]
        }
      ]
    }
  }
}
