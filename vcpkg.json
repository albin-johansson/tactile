{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "tactile",
  "license": "GPL-3.0",
  "version-semver": "0.5.0",
  "maintainers": [
    "albin-johansson"
  ],
  "builtin-baseline": "760bfd0c8d7c89ec640aec4df89418b7c2745605",
  "dependencies": [
    "boost-container",
    "boost-safe-numerics",
    "boost-stacktrace",
    "entt",
    "cppcodec",
    "fast-float",
    "fmt",
    "magic-enum",
    "stb"
  ],
  "features": {
    "tests": {
      "description": "Enable tests",
      "dependencies": [
        "gtest"
      ]
    },
    "editor": {
      "description": "Enable the editor application",
      "dependencies": [
        "argparse",
        {
          "name": "imgui",
          "features": [
            "docking-experimental",
            "sdl3-binding"
          ]
        },
        "sdl3",
        "tinyfiledialogs"
      ]
    },
    "opengl-renderer": {
      "description": "Enable OpenGL renderer",
      "dependencies": [
        {
          "name": "glad",
          "features": [
            "extensions"
          ]
        },
        {
          "name": "imgui",
          "features": [
            "opengl3-binding"
          ]
        }
      ]
    },
    "vulkan-renderer": {
      "description": "Enable Vulkan renderer",
      "dependencies": [
        "vulkan",
        "vulkan-memory-allocator",
        {
          "name": "sdl3",
          "features": [
            "vulkan"
          ]
        },
        {
          "name": "imgui",
          "features": [
            "vulkan-binding"
          ]
        }
      ]
    },
    "zlib-comp": {
      "description": "Enable Zlib compression support",
      "dependencies": [
        "zlib"
      ]
    },
    "zstd-comp": {
      "description": "Enable Zstd compression support",
      "dependencies": [
        "zstd"
      ]
    },
    "yaml-codec": {
      "description": "Enable Tactile YAML format codec support",
      "dependencies": [
        "yaml-cpp"
      ]
    },
    "tmj-codec": {
      "description": "Enable Tiled TMJ format codec support",
      "dependencies": [
        "nlohmann-json"
      ]
    },
    "tmx-codec": {
      "description": "Enable Tiled TMX format codec support",
      "dependencies": [
        "pugixml"
      ]
    }
  }
}
